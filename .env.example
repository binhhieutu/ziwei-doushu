# Sao chép thành .env.local; chỉ điền khóa trên máy chủ, không commit khóa thật.
# Không cần cấu hình AI nếu chỉ lập và xem lá số.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=replace-with-your-existing-router-key
AI_MODEL=replace-with-an-available-model-id
AI_MAX_TOKENS=2048

# URL công khai của ứng dụng, dùng cho canonical, sitemap và kiểm tra Origin.
# Phải trùng scheme/host/port trên thanh địa chỉ khi yêu cầu AI từ trình duyệt.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3018
